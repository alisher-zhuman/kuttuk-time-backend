# Copy to .env and fill in. Never commit .env. Full notes: CLAUDE.md → ENV variables.

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=kuttuktime
# true только для облачной БД (Koyeb), локально false
DATABASE_SSL=false
# true — TypeORM строит схему по entity (ТОЛЬКО локальная dev-БД).
# Иначе при старте применяются миграции — как на проде (там DB_SYNC=false).
DB_SYNC=true

# --- Auth ---
JWT_SECRET=
JWT_EXPIRATION=2h
# от @BotFather: проверка initData при входе и сообщения бота. Без него вход отклоняется.
BOT_TOKEN=

# --- App ---
PORT=3000
NODE_ENV=development
# браузерные адреса для CORS через запятую; пусто → localhost:5173 (не на проде)
ALLOWED_ORIGINS=http://localhost:5173
# https-адрес мини-аппа — кнопка меню бота (необязательно)
MINI_APP_URL=

# --- Cloudinary (логотипы) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Finik (оплата) — без них приложение не стартует ---
FINIK_BASE_URL=
FINIK_API_KEY=
FINIK_ACCOUNT_ID=
# base64 нашего приватного ключа: base64 -i finik_private.pem | tr -d '\n'
FINIK_PRIVATE_KEY_B64=
# base64 публичного ключа Finik (проверка подписи вебхуков)
FINIK_PUBLIC_KEY_B64=
# точный публичный адрес вебхука, с /api (по нему проверяется подпись)
FINIK_WEBHOOK_URL=https://kuttuk-time.koyeb.app/api/finik/webhook
# куда наш /api/payments/return/<id> отправляет покупателя после оплаты
FINIK_REDIRECT_URL=https://t.me/kuttuk_time_bot/app
