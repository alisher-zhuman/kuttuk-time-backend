# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=kuttuktime

# true только если БД требует SSL (Koyeb и др. облачные = true, локально = false)
DATABASE_SSL=false

# true — TypeORM сам создаёт/обновляет таблицы по entity.
# Включи на ПЕРВЫЙ запуск, потом выключи (false), чтобы не потерять данные.
DB_SYNC=true

# --- Auth ---
JWT_SECRET=your-very-secret-key-change-in-production
JWT_EXPIRATION=2h

# --- App ---
PORT=3000
NODE_ENV=development

# --- Finik (payments) ---
FINIK_BASE_URL=https://beta.api.acquiring.averspay.kg
FINIK_API_KEY=
FINIK_ACCOUNT_ID=
# base64 от finik_private.pem: base64 -i finik_private.pem | tr -d '\n'
FINIK_PRIVATE_KEY_B64=
# base64 публичного ключа Finik (для проверки webhook)
FINIK_PUBLIC_KEY_B64=
FINIK_WEBHOOK_URL=
FINIK_REDIRECT_URL=
